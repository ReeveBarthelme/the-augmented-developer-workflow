# Makefile.example — Example pre-merge target for the pre-merge-gate hook
#
# The pre-merge-gate.sh hook runs `make pre-merge` before allowing `gh pr merge`.
# Copy this to your project's Makefile and customize the targets.

.PHONY: pre-merge lint test security

# The gate the hook calls — must pass before merge is allowed
pre-merge: lint test security
	@echo "All pre-merge checks passed."

# Customize: your linting commands
lint:
	@echo "Running linters..."
	# Python: ruff check . && ruff format --check .
	# TypeScript: npx eslint . && npx tsc --noEmit
	# Go: golangci-lint run ./...

# Customize: your test commands
test:
	@echo "Running tests..."
	# Python: python3 -m pytest tests/ -v
	# TypeScript: npm test
	# Go: go test ./...

# Local mirror of .github/workflows/security.yml — runs the same scanners before
# merge so you catch bad/vulnerable deps and leaked secrets locally.
# Each tool is invoked only if installed, so this target degrades gracefully —
# but a tool that RUNS and finds a problem must FAIL the gate. The if/then/else
# form below is deliberate: `tool && ok || echo` would swallow a real finding
# (the tool's non-zero exit) and let the merge through. Do not "simplify" it.
# Customize: requirements.txt / src/ / pyproject.toml paths to match your project.
# Escape hatch for rapid iteration: SKIP_SECURITY=true make pre-merge
security:
	@echo "Running security checks..."
ifdef SKIP_SECURITY
	@echo "Security checks SKIPPED (SKIP_SECURITY=$(SKIP_SECURITY))"
else
	@if command -v gitleaks  >/dev/null 2>&1; then gitleaks detect --source . --config .gitleaks.toml --no-banner; else echo "  (gitleaks not installed — skipping secret scan)"; fi
	@if command -v pip-audit >/dev/null 2>&1; then pip-audit -r requirements.txt; else echo "  (pip-audit not installed — skipping Python CVE scan)"; fi
	@if command -v bandit    >/dev/null 2>&1; then bandit -r src/ -ll -c pyproject.toml; else echo "  (bandit not installed — skipping Python SAST)"; fi
	@if [ -f package.json ]; then npm audit --audit-level=high; else echo "  (no package.json — skipping npm audit)"; fi
	@echo "Security checks complete."
endif
