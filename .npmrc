# .npmrc — supply-chain hardening for npm / pnpm / yarn projects.
#
# Copy this to your project root. If you have a frontend (or any other)
# subdirectory with its own package.json, drop a copy there too — npm reads the
# nearest .npmrc to the package being installed.
#
# WHY ignore-scripts:
#   The single biggest npm supply-chain vector is malicious lifecycle scripts
#   (preinstall / install / postinstall) that execute automatically during
#   `npm install`. Self-propagating worms (the "shai-hulud" class, and the
#   TanStack-style install-hook attacks) abuse exactly this to exfiltrate tokens
#   and republish trojaned versions of popular packages. Setting
#   ignore-scripts=true blocks ALL install scripts, so a compromised dependency
#   cannot run code on your machine or in CI just by being installed.
ignore-scripts=true

# Refuse to pass `npm audit` when any dependency carries a known high-or-critical
# advisory. Pair with the npm-audit job in .github/workflows/security.yml.
audit-level=high

# ---------------------------------------------------------------------------
# TRADE-OFF / ESCAPE HATCH
#   ignore-scripts=true also disables install scripts for packages that
#   legitimately need them (native builds: better-sqlite3, esbuild, sharp,
#   node-sass, etc.). When you TRUST a specific package and it needs its build
#   step, run it explicitly instead of globally re-enabling scripts:
#
#       npm rebuild <pkg>                         # run build for one package
#       npm install <pkg> --ignore-scripts=false  # one-off install w/ scripts
#       npm ci --foreground-scripts               # see what scripts would run
#
#   Do NOT delete this file to "fix" a failing native build — scope the
#   exception to the one package that needs it.
# ---------------------------------------------------------------------------
