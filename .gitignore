# Environment
.env
.env.local
.env.*.local

# Credentials / private keys — never commit these to a repo (esp. a public one).
# A leaked private key or service-account JSON is far more dangerous than a
# public Firebase web key. Un-ignore a specific file with `!path` if truly needed.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
*-key.json
serviceAccount*.json
service-account*.json
gha-creds-*.json
credentials.json

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Claude Code local settings (contains user-specific allowed commands with absolute paths)
.claude/settings.local.json

# Claude Code runtime logs (post-merge-cleanup, etc.)
.claude/logs/

# Delegation/context metrics written by the .claude hooks
.claude/metrics/

# Retained local-CI logs from post-create-check.sh
.claude/ci-logs/

# Per-worktree session lease written by .claude/hooks/worktree-lease.sh
.session-lease

# Git worktrees (created by the orchestrate-* / worktree workflow)
.worktrees/

# Python bytecode (scripts/classify_failures/)
__pycache__/
*.py[cod]

# Local act secrets + env for scripts/act-local-ci.sh.
# .actrc itself is NOT ignored: it only maps runner labels to images and sets
# --bind, the whole team needs the same one, and lib-act-ci.sh depends on it.
.act-secrets
.act-env

# Temp
/tmp/
*.log
